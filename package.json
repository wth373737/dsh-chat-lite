{
  "name": "dsh-chat-lite",
  "version": "0.12.0",
  "type": "module",
  "description": "A chat area for DeepSeek Harness: a desktop sidebar panel plus a phone-installable web app, with a self-managed history library, full-text search and document text extraction.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "chat",
    "deepseek-harness",
    "pwa"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wth373737/dsh-chat-lite.git"
  },
  "bugs": {
    "url": "https://github.com/wth373737/dsh-chat-lite/issues"
  },
  "homepage": "https://github.com/wth373737/dsh-chat-lite#readme",
  "scripts": {
    "import": "node tools/build-history.mjs",
    "check": "node --check index.js && node --check client.js && node --check mobile.js && node --check ui/app.js && node --check ui/sw.js && node tools/check-ui.mjs && node tools/check-client-id.mjs",
    "test": "node --test test/host.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./mobile": "./mobile.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./tools/build-history.mjs": "./tools/build-history.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "mobile.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "ui/*",
    "tools/build-history.mjs",
    "README.md",
    "LICENSE",
    "tools/check-ui.mjs",
    "office.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
