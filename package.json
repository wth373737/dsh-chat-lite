{
  "name": "@local/dsh-chat-lite",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "DSH 闲聊区：桌面面板 + 可安装到手机的独立网页 App（历史库、全文搜索、文档读取）",
  "keywords": [
    "dsh",
    "cordis-plugin",
    "chat",
    "deepseek-harness"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wth373737/dsh-chat-lite.git"
  },
  "scripts": {
    "import": "node tools/build-history.mjs",
    "check": "node --check index.js && node --check client.js && node --check mobile.js && node --check ui/app.js && node --check ui/sw.js && node tools/check-ui.mjs",
    "test": "node --test test/host.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./mobile": "./mobile.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./tools/build-history.mjs": "./tools/build-history.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "mobile.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "ui/*",
    "tools/build-history.mjs",
    "README.md",
    "LICENSE",
    "tools/check-ui.mjs",
    "office.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
